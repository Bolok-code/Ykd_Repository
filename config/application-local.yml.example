# 本地开发配置模板
# 复制为 config/application-local.yml 并填入真实密钥：
#   Windows PowerShell:  Copy-Item config\application-local.yml.example config\application-local.yml
#   Linux / macOS:       cp config/application-local.yml.example config/application-local.yml
#
# 注意：
#   - config/application-local.yml 已被 .gitignore 忽略，真实密钥不会提交到仓库。
#   - 请把 key 的 changeme 占位值全部换成真实 Key。ApiKeyStartupValidator 会在启动时
#     检测到仍为 changeme 的 Key 并快速失败，提示补全，避免带病启动后 AI 功能静默失效。

spring:
  ai:
    # ── Agnes（识图 / 画图 / 视频，OpenAI 兼容协议）────────────
    # base-url 与模型名使用 application.yml 中的默认值，这里只需填 Key。
    openai:
      api-key: changeme
      # Embedding 走阿里 DashScope，与上方的 Agnes Key 相互独立
      embedding:
        api-key: changeme
        base-url: https://dashscope.aliyuncs.com/compatible-mode/v1
        options:
          model: text-embedding-v3
    # ── DeepSeek 主对话模型 ─────────────────────────────────
    deepseek:
      api-key: changeme
    # ── ElevenLabs 语音合成 ─────────────────────────────────
    elevenlabs:
      api-key: changeme
      tts:
        voice-id: EXAVITQu4vr4xnSDxMaL        # 女声（默认音色）
        male-voice-id: pNInz6obpgDQGcFmaJgB   # 男声

gaode:
  key: changeme

web-search:
  enabled: true
  api-key: changeme                           # 火山引擎搜索 API Key
  endpoint: https://open.feedcoopapi.com/search_api/web_search
  max-results: 5
  timeout-seconds: 15

liepin:
  enabled: false
  headless: false
  profile-directory: ./work/liepin/browser-profile
  resume-directory: ./work/liepin/resumes
  auto-apply:
    enabled: false
    scan-interval-ms: 60000
    default-daily-limit: 3
    max-daily-limit: 20
    default-min-match-score: 85
    default-interval-minutes: 30
    max-consecutive-failures: 3
